rules_version = '2';
// เลิกใช้ฐานข้อมูลนี้ตั้งแต่ 20 พ.ย. 2569 — ย้ายไป Google Sheet/Drive แล้ว (ดูโฟลเดอร์ gas/)
// เก็บข้อมูลเดิมไว้เป็นสำรอง: อ่านได้ แต่ห้ามเขียน
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
